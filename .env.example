# Sao chép thành .env và điền giá trị thật. .env KHÔNG được commit.

# --- Proxy model (bắt buộc) ---
# Proxy local tương thích OpenAI (kiểu CLI-Proxy-API). Agent chỉ gọi
# model qua đây, không dùng API chính thức của hãng nào.
PROXY_BASE_URL=http://127.0.0.1:8317/v1
PROXY_API_KEY=local-proxy

# Tên model như proxy công bố. Đổi model = đổi cấu hình, không sửa code.
MODEL_BRAIN=gemini-3.8-flash
MODEL_CHEAP=gemini-3.8-flash
MODEL_ESCALATED=gemini-3.8-flash

# --- Telegram (bắt buộc để chạy bot) ---
TELEGRAM_BOT_TOKEN=
# Telegram user id của CHÍNH bạn — chỉ id này ra lệnh được cho bot.
ALLOWED_USER_ID=
# Trong group có người khác: bot chỉ đáp khi được mention/reply.
GROUP_MENTION_ONLY=1
DEBOUNCE_SECONDS=2.5

# --- Tùy chọn ---
# MULON_DB_PATH=data/mulon.db
# MULON_DOSSIER_DIR=dossier
# MULON_WORKSPACE_DIR=workspace
# CONTEXT_WINDOW_TOKENS=200000
# TOOL_RESULT_MAX_CHARS=8000
# ALLOW_OUTSIDE_WORKSPACE=0

# --- Phase 2: ký ức sống ---
# Embedder cho hybrid recall: fastembed (bge-m3 local, cần cài thêm
# gói fastembed) | stub (chỉ cho test) | off. Không có embedder thì
# recall tự chạy BM25-only.
# EMBEDDER_BACKEND=fastembed
# EMBEDDER_MODEL=BAAI/bge-m3
# RECALL_VECTOR_WEIGHT=0.7
# RECALL_BM25_WEIGHT=0.3
# Review fork sau mỗi lượt (ghi digest + fact nền): 1/0
# REVIEW_FORK_ENABLED=1
# Consolidation worker nền — MẶC ĐỊNH TẮT, chỉ bật khi bạn muốn:
# CONSOLIDATION_ENABLED=0
# CONSOLIDATION_INTERVAL_S=900

# --- Phase 3: tay chân ---
# MCP servers (stdio) khai trong file này, server nào "enabled": true
# mới được nối khi bot khởi động:
# MCP_CONFIG_PATH=config/mcp_servers.json
# Scheduler nền — MẶC ĐỊNH TẮT (không job nào tự chạy khi chưa bật
# đích danh). Bật lên thì các lịch tạo bằng tool schedule_task mới chạy:
# SCHEDULER_ENABLED=0
# SCHEDULER_TICK_S=30
# Múi giờ mặc định cho cron và hiển thị:
# DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Subagents: tối đa chạy đồng thời / trần lời gọi model / trần token:
# SUBAGENT_MAX_CONCURRENT=4
# SUBAGENT_MAX_LLM_CALLS=15
# SUBAGENT_TOKEN_BUDGET=60000
# Browser profile bền (giữ đăng nhập giữa các lần chạy). Để trống
# = profile tạm như mặc định:
# BROWSER_PROFILE_DIR=

# --- Phase 4: chủ động + tiếng nói + media ---
# Proactivity (heartbeat gom việc) — MẶC ĐỊNH TẮT, chỉ chạy khi bật
# đích danh. Bật lên cũng CHỈ xếp hàng đề xuất vào DB, chưa tự gửi:
# PROACTIVITY_ENABLED=0
# PROACTIVITY_INTERVAL_S=1800
# PROACTIVITY_ACTIVE_HOURS=07:00-23:00
# Voice tương tác: nghe bằng faster-whisper (gói tuỳ chọn), nói
# bằng TTS qua proxy (POST /audio/speech). Proxy không hỗ trợ
# speech thì trả lời bằng giọng tự tắt sạch, text vẫn chạy:
# VOICE_WHISPER_MODEL=large-v3
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=nova
# VOICE_TTS_FORMAT=opus
# VOICE_UNDERSTAND=1
# Media tools dùng ffmpeg/ffprobe trên máy (đường dẫn nếu khác lạ):
# MEDIA_FFMPEG=ffmpeg
# MEDIA_FFPROBE=ffprobe
# Thư mục skills SKILL.md (mỗi thư mục con là 1 skill):
# SKILLS_DIR=skills

# --- Phase 5: cứng hóa ---
# Cổng eval vàng (python -m mulon.evals): pass rate dưới ngưỡng
# này thì thoát mã 1. EVAL_LIVE=1 = chạy eval bằng gateway thật
# qua proxy thay vì stub offline:
# EVAL_PASS_THRESHOLD=0.85
# EVAL_LIVE=0
# Langfuse tracing TUỲ CHỌN — phải đủ cả 3 biến mới bật; trace chỉ
# chứa metadata (model/token/latency/độ dài), KHÔNG chứa nội dung
# tin nhắn hay prompt:
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# Thư mục chứa các gói backup (python -m mulon.backup create):
# BACKUP_DIR=backups
