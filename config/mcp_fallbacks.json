{
 "google-workspace-mcp": {
  "command": "uvx",
  "args": [
   "--python",
   "3.12",
   "workspace-mcp",
   "--single-user",
   "--tool-tier",
   "core"
  ],
  "package": {
   "ecosystem": "pypi",
   "name": "workspace-mcp",
   "version": "2.2.0",
   "pinned": false
  },
  "setup_requirements": [],
  "warnings": [
   {
    "code": "download_and_run",
    "severity": "medium",
    "text": "'uvx' tải và chạy Google Workspace MCP từ PyPI."
   }
  ]
 },
