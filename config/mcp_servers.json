{
  "servers": {
    "mcp-marketplace": {
      "type": "http",
      "url": "https://mcp-marketplace.io/api/mcp/mcp"
    },
    "google-workspace": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "workspace-mcp",
        "--single-user",
        "--tool-tier",
        "core"
      ],
      "env": {
        "WORKSPACE_MCP_PORT": "8001",
        "GOOGLE_OAUTH_REDIRECT_URI": "https://refinance-displayed-wing-approximate.trycloudflare.com/oauth2callback"
      },
      "env_vault_refs": {
        "GOOGLE_OAUTH_CLIENT_ID": "google:client_id",
        "GOOGLE_OAUTH_CLIENT_SECRET": "google:client_secret"
      },
      "enabled": true
    }
  }
}
